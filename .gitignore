# ==========================================
# Git Ignore - Fullstack Social Media App
# ==========================================

# Dependencies
node_modules/
*/node_modules/

# Production Builds
dist/
*/dist/
build/
*/build/

# Environment Files (Keep secrets private!)
.env
.env.*
!.env.example
*.env
*/.env
*/.env.*
!*/.env.example

# Local Uploaded Images & Files (Keep repo lightweight)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
